@model ErrorViewModel
@{ ViewData["Title"] = "Ошибка"; }
<h1>Не удалось выполнить запрос</h1>
<p>Повторите попытку или вернитесь на страницу расчёта.</p>
@if (Model.ShowRequestId)
{
    <p>Идентификатор запроса: <code>@Model.RequestId</code></p>
}
<a asp-controller="Home" asp-action="Index">К расчётам</a>
